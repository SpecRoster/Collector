**/testdata/**/*.lock
**/testdata/**/package-lock.json
**/testdata/**/Gemfile.lock
**/testdata/**/Cargo.lock
**/testdata/**/.gradle/
**/testdata/**/coverage/
**/testdata/**/TestResults/
**/testdata/**/*.trx
**/testdata/**/.phpunit.result.cache

# Coverage artifacts produced by running the collector
coverage.json
collected.txt
*.coverage

# Partner names for the disclosure hooks — never committed.
scripts/disclosure-patterns.local
