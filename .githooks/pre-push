#!/usr/bin/env bash
# Backstop. pre-commit and commit-msg can be skipped with --no-verify, and
# neither ran on commits that predate these hooks. This is the last gate
# before anything leaves the machine, so it re-scans every commit actually
# being pushed — contents and messages both.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
. .githooks/_scan.sh
RE="$(partner_regex)" || exit 1

fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"; limit="--not --remotes"
  else
    range="$remote_sha..$local_sha"; limit=""
  fi
  commits=$(git rev-list $range $limit 2>/dev/null | head -500)
  for c in $commits; do
    if bad=$(git log -1 --format='%B' "$c" | grep -inE "$RE"); then
      echo "BLOCKED: commit $(git log -1 --format=%h "$c") message names a partner:" >&2
      printf '%s\n' "$bad" | sed 's/^/    /' >&2; fail=1
    fi
    if bad=$(git show --format= -U0 "$c" | grep -E '^\+' | grep -v '^+++' | grep -inE "$RE"); then
      echo "BLOCKED: commit $(git log -1 --format=%h "$c") adds partner-identifying content:" >&2
      printf '%s\n' "$bad" | head -10 | sed 's/^/    /' >&2; fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "Push refused. Rewrite the offending commits — once pushed, removing" >&2
  echo "this needs a history rewrite AND a GitHub Support ticket for the" >&2
  echo "pull-request refs a force-push cannot reach." >&2
  exit 1
fi
